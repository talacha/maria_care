# openai (local FastAPI / Docker) or hf (Hugging Face Space / Gradio)
LLM_PROVIDER=openai

# --- OpenAI-compatible provider ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional. Leave unset unless using an OpenAI-compatible gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Hugging Face Inference Providers ---
# Set as a Space secret named HF_TOKEN (pydantic also accepts HF_TOKEN).
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_PROVIDER=auto

DATABASE_URL=sqlite:///./data/healthcare.db
